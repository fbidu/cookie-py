# Copy to `.env`, which git ignores. Read by `Client.from_env()` and by the
# demo, `python -m {{ pkg_name }}`.
{{ pkg_name | upper }}_API_KEY=
# Optional. The default is the base URL in `{{ pkg_name }}/settings.py`.
# {{ pkg_name | upper }}_BASE_URL=
# Optional. In seconds; the default is 10.
# {{ pkg_name | upper }}_TIMEOUT=
{%- if spec_first %}

# Read by `tools/openapi_agents`, which writes `openapi.yaml`.
OPENROUTER_API_KEY=
# Optional. An OpenRouter model id; the default is anthropic/claude-opus-5.5.
# OPENAPI_AGENTS_MODEL=
{%- endif %}
