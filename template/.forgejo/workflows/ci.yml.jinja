---
# CI — Forgejo Actions. Runs the full prek suite (lint + type-check + tests) in
# one job: the same gate the pre-commit / pre-push hooks give developers.
#
# `runs-on: ubuntu-latest` must match a label your act_runner registers. That
# runner image is expected to provide git + node (for JS actions like
# checkout/cache) + python/pip; uv and the project's dev tools install at
# runtime — no baked CI image, matching the "no CI registry" convention. Action
# refs are kept current by Renovate (major-bump PRs only; minor/patch frozen in
# renovate.json).
name: CI

on:
  push:
    branches:
      - main
  pull_request:
    branches:
      - main

# The runners are shared with every other repo. A newer push to the same ref
# makes the running one obsolete, so cancel it and free its slot.
concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  prek:
    # `ubuntu-latest` is the default `homelab` runner. It caps each job at
    # 2 GiB of memory with swap off: a job that goes over is OOM-killed and
    # exits with code 137, with no warning first.
{%- if project_type != "docs" %}
    #
    # Tests that start their own services (testcontainers, a compose database)
    # need `runs-on: dind`. On the default runner such a service publishes to
    # the host's loopback, so the tests cannot reach it on 127.0.0.1. `dind`
    # runs one job at a time and keeps its own cache, so move only a job that
    # needs it.
{%- endif %}
    #
    # Runners and limits: https://docs.lx.e6a.app/ansible/conventions/#cicd
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7

      - name: Install uv
        # PEP 668: the job container's Python is externally managed.
        run: pip install --no-cache-dir --break-system-packages uv

      # Before adding or changing a cache key, read
      # https://docs.lx.e6a.app/ansible/ci-caching/
      - name: Cache uv
        uses: actions/cache@v6.1.0
        with:
          path: ~/.cache/uv
          key: uv-{% raw %}${{ hashFiles('uv.lock') }}{% endraw %}

      - name: Install Python {{ python_version }}
        run: uv python install {{ python_version }}

      - name: Install dependencies
        run: uv sync --dev --all-extras

      - name: Cache prek hook environments
        uses: actions/cache@v6.1.0
        with:
          path: ~/.cache/prek
          key: prek-{% raw %}${{ hashFiles('.pre-commit-config.yaml') }}{% endraw %}

      - name: prek (commit stage)
        run: uv run prek run --all-files --show-diff-on-failure --hook-stage pre-commit
{%- if project_type != "docs" %}

      - name: prek (push stage — pytest)
        run: uv run prek run --all-files --show-diff-on-failure --hook-stage pre-push
{%- endif %}
