name: CI

on:
  push:
  pull_request:
    branches:
      - main

jobs:
  prek:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: astral-sh/setup-uv@v10.3.2
        with:
          enable-cache: true
          cache-dependency-glob: |
            uv.lock
            .python-version
      - run: uv sync --dev --all-extras
      - uses: actions/cache@v6.1.0
        with:
          path: ~/.cache/prek
          key: prek-{% raw %}${{ runner.os }}-${{ hashFiles('.pre-commit-config.yaml') }}{% endraw %}
      - name: prek (commit stage)
        run: uv run prek run --all-files --show-diff-on-failure --hook-stage pre-commit
{%- if project_type != "docs" %}
      - name: prek (push stage — pytest)
        run: uv run prek run --all-files --show-diff-on-failure --hook-stage pre-push
{%- endif %}
