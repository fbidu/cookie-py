# See https://pre-commit.com for more information
# See https://pre-commit.com/hooks.html for more hooks
default_install_hook_types: [pre-commit{% if project_type != "docs" %}, pre-push{% endif %}]

repos:
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v6.0.0
    hooks:
      - id: trailing-whitespace
        stages: [pre-commit]
      - id: end-of-file-fixer
        stages: [pre-commit]
      - id: check-yaml
        stages: [pre-commit]
      - id: check-added-large-files
        stages: [pre-commit]
      - id: check-toml
        stages: [pre-commit]
      - id: check-json
        stages: [pre-commit]
{% if ci_provider == "github" %}
  - repo: https://github.com/rhysd/actionlint
    rev: v1.7.12
    hooks:
      - id: actionlint
        stages: [pre-commit]
{% endif %}
  - repo: local
    hooks:
{%- if project_type != "docs" %}
      # ruff and bandit run from the project's environment, not from pinned
      # hook repos: the hooks, `uv run` and CI then share the versions in uv.lock.
      - id: ruff
        name: ruff
        entry: uv run ruff check --fix --force-exclude
        language: system
        types_or: [python, pyi]
        require_serial: true
        stages: [pre-commit]

      - id: ruff-format
        name: ruff format
        entry: uv run ruff format --force-exclude
        language: system
        types_or: [python, pyi]
        require_serial: true
        stages: [pre-commit]

      - id: bandit
        name: bandit
        entry: uv run bandit -c pyproject.toml
        language: system
        types: [python]
        exclude: ^tests/
        require_serial: true

      - id: pyright
        name: pyright
        entry: uv run pyright
        language: system
        types: [python]
        stages: [pre-commit]
        pass_filenames: false
{% endif %}
      - id: mkdocs-build
        name: mkdocs build
        entry: uv run mkdocs build --strict
        language: system
        files: ^(docs/|mkdocs\.yml$
{%- if project_type != "docs" %}|{{ pkg_name }}/{% endif %})
        stages: [pre-commit]
        pass_filenames: false
{%- if project_type != "docs" %}

      - id: pytest
        name: pytest
        entry: uv run pytest
        language: system
        pass_filenames: false
        stages: [pre-push]
        verbose: true
{%- endif %}
