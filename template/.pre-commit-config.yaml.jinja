# See https://pre-commit.com for more information
# See https://pre-commit.com/hooks.html for more hooks
default_install_hook_types: [pre-commit{% if project_type != "docs" %}, pre-push{% endif %}]

repos:
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v6.0.0
    hooks:
      - id: trailing-whitespace
        stages: [pre-commit]
      - id: end-of-file-fixer
        stages: [pre-commit]
      - id: check-yaml
        stages: [pre-commit]
      - id: check-added-large-files
        stages: [pre-commit]
      - id: check-toml
        stages: [pre-commit]
      - id: check-json
        stages: [pre-commit]
{% if project_type != "docs" %}
  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: v0.15.17
    hooks:
      - id: ruff
        args: [--fix]
        stages: [pre-commit]
      - id: ruff-format
        stages: [pre-commit]

  - repo: https://github.com/PyCQA/bandit
    rev: "1.9.4"
    hooks:
      - id: bandit
        args: ["-c", "pyproject.toml"]
        additional_dependencies: ["bandit[toml]"]
        exclude: ^tests/
{% endif %}
{%- if ci_provider == "github" %}
  - repo: https://github.com/rhysd/actionlint
    rev: v1.7.12
    hooks:
      - id: actionlint
        stages: [pre-commit]
{% endif %}
  - repo: local
    hooks:
{%- if project_type != "docs" %}
      - id: pyright
        name: pyright
        entry: uv run pyright
        language: system
        types: [python]
        stages: [pre-commit]
        pass_filenames: false
{% endif %}
      - id: mkdocs-build
        name: mkdocs build
        entry: uv run mkdocs build --strict
        language: system
        files: ^(docs/|mkdocs\.yml$
{%- if project_type != "docs" %}|{{ pkg_name }}/{% endif %})
        stages: [pre-commit]
        pass_filenames: false
{%- if project_type != "docs" %}

      - id: pytest
        name: pytest
        entry: uv run pytest
        language: system
        pass_filenames: false
        stages: [pre-push]
        verbose: true
{%- endif %}
